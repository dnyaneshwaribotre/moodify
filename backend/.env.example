DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (created by database/create_database.sql)
DB_NAME=moodify
DB_USER=moodify
DB_PASSWORD=Dnyana@11
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional AI upgrade. Leave blank to use the built-in mood analyzer (works offline, free).
# With a key, Claude reads the mood; on any error the app silently falls back to the built-in analyzer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# YouTube Data API v3 key for finding embeddable videos for full-song playback.
# Optional: without a key, Moodify finds the song on YouTube automatically.
YOUTUBE_API_KEY=

# Optional Spotify Web API metadata/search (not audio streaming).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# JioSaavn (unofficial) is tried first for playback. Leave blank to use the default public host,
# or point this at your own self-hosted jiosaavn-api (e.g. https://your-app.vercel.app).
SAAVN_API_URL=
